# ==============================================================================
# Vigil Summit — Backend (copie para .env e preencha)
# ==============================================================================

# Segurança dos endpoints internos (o n8n envia este valor no header X-API-Key)
BACKEND_API_KEY=troque-esta-chave

# Origens liberadas no CORS (landing local)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...
# Connection string (Dashboard > Connect > Session pooler). Usada pela memória
# do LangChain (PostgresChatMessageHistory).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Anthropic ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=1024

# --- Evolution API (WhatsApp) ----------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=mesma-chave-do-docker-compose
EVOLUTION_INSTANCE=vigil

# --- Google (Sheets + Calendar) ---------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# OAuth do dono da agenda (recomendado p/ Calendar): convites entram na agenda
# do lead e o free/busy real é consultado. Gere com: python -m scripts.google_oauth_setup
GOOGLE_OAUTH_CLIENT_FILE=credentials/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/google_oauth_token.json
GOOGLE_SHEETS_ID=1AbC...id-da-planilha...
GOOGLE_SHEETS_WORKSHEET=Validacao
GOOGLE_CALENDAR_ID=primary

# --- Reuniões pós-evento -------------------------------------------------------------
MEETING_TIMEZONE=America/Sao_Paulo
MEETING_BUSINESS_START_HOUR=9
MEETING_BUSINESS_END_HOUR=18
MEETING_MIN_LEAD_DAYS=2
MEETING_SEARCH_DAYS=10

# --- E-mail (SMTP Gmail com app password) ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=app-password-de-16-digitos
SMTP_FROM=Vigil Summit <voce@gmail.com>
SALES_ALERT_EMAIL=comercial@suaempresa.com
# True => não envia e-mails reais, apenas registra em log (útil para demo)
EMAIL_MOCK_MODE=false

# --- Evento --------------------------------------------------------------------------
EVENT_NAME=Vigil Summit — Segurança para a Era da IA
EVENT_DATE=2026-08-20T09:00:00-03:00
EVENT_LOCATION=São Paulo, SP
EVENT_LANDING_URL=http://localhost:5173
# Receitas de teste
# Pré-evento (disparar a régua proativa): coloque a data alguns dias à frente para "entrar" na janela do toque que quer testar. Hoje é 13/07, então:

# Para testar	EVENT_DATE sugerido
# companion (D-7)	2026-07-19T09:00:00-03:00 (evento em ~6 dias)
# content (D-5)	2026-07-17T09:00:00-03:00 (~4 dias)
# logistics (D-1)	2026-07-14T09:00:00-03:00 (amanhã)
# day_of (H-3)	hoje, ~2h à frente do horário atual
# Com um lead confirmado, chame POST /internal/cadence/run (ou espere o workflow 05). Lembre: a régua envia no máximo 1 toque por lead a cada 20h — para testar vários toques em sequência, apague as linhas do lead em cadence_log entre um teste e outro (delete from cadence_log where lead_id = '...').

# Pós-evento (follow-up + agendamento): coloque a data no passado, ex.: 2026-07-10T09:00:00-03:00, marque o lead como participante:


# update leads set status = 'compareceu' where id = 'SEU_LEAD_ID';
# e chame POST /internal/follow-ups/run — a Sofia inicia o follow-up e conduz ao agendamento de reunião.

# Importante: depois de editar o .env, reinicie o backend — as configurações são cacheadas no startup (get_settings() com lru_cache), então o processo em execução não vê a mudança.