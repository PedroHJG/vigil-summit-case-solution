# ==============================================================================
# n8n-evolution/.env — copie para .env antes de rodar `docker compose up -d`
#
# O serviço `api` do docker-compose.yml usa a imagem oficial
# evoapicloud/evolution-api e carrega este arquivo inteiro via `env_file: .env`.
# Essa imagem aceita DEZENAS de variáveis (webhooks, S3, RabbitMQ, Chatwoot,
# métricas...) — a lista completa e atualizada está no repositório oficial:
# https://github.com/EvolutionAPI/evolution-api (arquivo `.env.example` deles).
# Abaixo está o SUBCONJUNTO MÍNIMO que este projeto realmente precisa para
# subir a Evolution API + Postgres + Redis + n8n como estão neste
# docker-compose.yml. Adicione outras variáveis do template oficial só se for
# usar recursos que este projeto não usa (S3, Chatwoot, RabbitMQ etc.).
# ==============================================================================

# --- Evolution API: identidade e rede -----------------------------------------
# Chave que o backend usa no header `apikey` para chamar a Evolution
# (mesmo valor de backend/.env -> EVOLUTION_API_KEY)
AUTHENTICATION_API_KEY=troque-esta-chave
# URL pela qual a própria Evolution se enxerga (usada para montar links/QR code)
SERVER_URL=http://localhost:8080
CONFIG_SESSION_PHONE_CLIENT=VigilSummit
LOG_LEVEL=ERROR,WARN,INFO

# --- Evolution API: Postgres interno (serviço evolution-postgres) --------------
# Estas 3 variáveis alimentam TANTO o container evolution-postgres
# (POSTGRES_DB/USER/PASSWORD) QUANTO a connection string da própria Evolution
# (DATABASE_CONNECTION_URI abaixo) — mantenha os três valores coerentes.
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=evolution
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@evolution-postgres:5432/evolution?schema=public
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true

# --- Evolution API: cache Redis (serviço redis) ---------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution

# --- Variáveis injetadas no n8n (usadas nos workflows via {{ $env.X }}) ---------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...
# URL do backend FastAPI visto de dentro do container do n8n:
BACKEND_URL=http://host.docker.internal:8000
# Mesma chave do backend/.env -> BACKEND_API_KEY
BACKEND_API_KEY=troque-esta-chave