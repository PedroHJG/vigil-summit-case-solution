{
  "name": "Vigil Summit — 04 Validation Watcher (Sheets)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "d4e5f6a7-0004-4000-8000-000000000001",
      "name": "A cada 2 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/v1/internal/validations/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.BACKEND_API_KEY }}" }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "d4e5f6a7-0004-4000-8000-000000000002",
      "name": "Checar validações (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    }
  ],
  "connections": {
    "A cada 2 min": {
      "main": [
        [
          { "node": "Checar validações (backend)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}